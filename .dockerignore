# Контекст Docker-сборки — корень проекта. Исключаем всё, что не нужно образу.
.git
.gitignore
.codeassistantignore
.idea
.vscode

# backend/.env и SophyGoContainer/key.json намеренно НЕ исключаются:
# по требованию они копируются в образ для запуска через start_services.py.

# Runtime-данные и локальные артефакты
backend/data/
backend/bin/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/dist/
frontend/node_modules/

screenshots/
plans/
scripts/.run/
**/__pycache__/
**/*.pyc
.DS_Store
