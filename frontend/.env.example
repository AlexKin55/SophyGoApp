# --- Логирование (по умолчанию выключено) ---
# true — писать логи в консоль и отправлять их на backend.
VITE_LOGGING_ENABLED=false
VITE_LOG_LEVEL=debug
VITE_CLIENT_LOG_ENDPOINT=/api/v1/client-logs
VITE_CLIENT_LOG_BATCH_SIZE=20
VITE_CLIENT_LOG_FLUSH_MS=1000
# Лог Vite dev-сервера. Читается скриптом scripts/start_services.py,
# в браузер не попадает (поэтому без префикса VITE_).
LOG_FILE=/tmp/sophygoapp/frontend.log

# --- Backend API ---
# Базовый URL backend-сервиса.
# Пустое значение (по умолчанию) — HTTP и WebSocket идут на тот же Origin:
# в dev их проксирует Vite, на VPS — nginx.
# Для прямого обращения к сервису: http://localhost:8080
VITE_API_BASE_URL=
# Таймаут HTTP-запросов к backend, мс.
VITE_API_REQUEST_TIMEOUT_MS=15000

# Локальная отладка в обычном браузере без Telegram WebApp.
# true — разрешает подключение Гида без initData.
# На backend при этом должен быть задан DEV_AUTH_USER_ID.
VITE_DEV_AUTH=false
# Сколько ждать загрузку Telegram SDK, мс.
VITE_TELEGRAM_SDK_TIMEOUT_MS=4000

# --- Silero VAD (ONNX/WASM) ---
# По умолчанию используются локальные файлы из /vad/ и /ort/
# (создаются командой `npm run vad:assets`).
# При необходимости можно переключиться на CDN:
# VITE_VAD_ASSET_BASE_URL=https://cdn.jsdelivr.net/npm/@ricky0123/vad-web@0.0.31/dist/
# VITE_ORT_ASSET_BASE_URL=https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.1/dist/
# Оба значения должны заканчиваться на "/".
VITE_VAD_ASSET_BASE_URL=/vad/
VITE_ORT_ASSET_BASE_URL=/ort/
VITE_VAD_SPEECH_THRESHOLD=0.5
VITE_VAD_NEGATIVE_THRESHOLD=0.35
VITE_VAD_FRAME_STALE_MS=3000
VITE_VAD_REDEMPTION_MS=700
VITE_VAD_PRE_SPEECH_PAD_MS=300
VITE_VAD_MIN_SPEECH_MS=250
VITE_VAD_NUM_THREADS=1
VITE_VAD_SIMD=true

# --- Аудио ---
VITE_AUDIO_SAMPLE_RATE=16000
VITE_AUDIO_CAPTURE_BUFFER_SIZE=4096
VITE_AUDIO_BASE64_CHUNK_SIZE=8192

# --- Голосовой Гид ---
# Порог RMS для резервного VAD, пока Silero VAD загружается.
VITE_GUIDE_RMS_THRESHOLD=0.02
# Сколько кадров речи нужно для перебивания при RMS-fallback.
VITE_GUIDE_BARGE_IN_FRAMES=2
# Тишина до выключения микрофона, мс.
VITE_GUIDE_IDLE_TIMEOUT_MS=45000
# Период проверки тишины, мс.
VITE_GUIDE_IDLE_CHECK_INTERVAL_MS=5000
# Таймаут установки WebSocket-соединения, мс.
VITE_GUIDE_CONNECT_TIMEOUT_MS=10000

# --- Достопримечательности (Wikipedia / OSM) ---
VITE_WIKIPEDIA_API_URL=https://ru.wikipedia.org/w/api.php
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
VITE_PLACES_MAX_RESULTS=30
VITE_PLACES_GEOSEARCH_LIMIT=500
VITE_PLACES_CATEGORY_CANDIDATES=100
VITE_PLACES_TITLES_PER_REQUEST=50
VITE_PLACES_IMAGES_BATCH=20
VITE_PLACES_REQUEST_TIMEOUT_MS=30000
VITE_PLACES_CACHE_TTL_MS=120000
VITE_PLACES_CACHE_LIMIT=50
VITE_PLACES_MAX_CONCURRENT_REQUESTS=2
VITE_PLACES_RETRY_DELAY_MS=1000
VITE_PLACES_OSM_RESERVED=10
VITE_PLACES_OSM_WAIT_MS=4000
VITE_PLACES_NOMINATIM_TIMEOUT_MS=4000
VITE_PLACES_NOMINATIM_DELAY_MS=1100
VITE_PLACES_NOMINATIM_QUERIES=парк,сквер
VITE_PLACES_MAX_LAT_SPAN=3
VITE_PLACES_MAX_LON_SPAN=6
VITE_PLACES_GRID_SIZE=2

# --- Геолокация и обратное геокодирование ---
VITE_GEO_HIGH_ACCURACY=true
VITE_GEO_TIMEOUT_MS=10000
VITE_GEO_MAXIMUM_AGE_MS=5000
VITE_GEO_ROUND_FACTOR=1000
VITE_REVERSE_GEOCODE_DEBOUNCE_MS=400
VITE_REVERSE_GEOCODE_TIMEOUT_MS=4000
VITE_REVERSE_GEOCODE_ZOOM=10
VITE_REVERSE_GEOCODE_LANGUAGE=ru

# --- Карта ---
VITE_MAP_CENTER_LAT=55.751244
VITE_MAP_CENTER_LON=37.618423
VITE_MAP_ZOOM=13
VITE_MAP_MOVE_DEBOUNCE_MS=500
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
