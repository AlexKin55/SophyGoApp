# --- Логирование (по умолчанию выключено) ---
# true — писать логи backend в LOG_FILE и принимать логи frontend.
LOGGING_ENABLED=false
LOG_FILE=/tmp/sophygoapp/backend.log
LOG_LEVEL=info
LOG_FORMAT=json
CLIENT_LOG_FILE=/tmp/sophygoapp/frontend-client.log
CLIENT_LOG_MAX_BODY_BYTES=65536
CLIENT_LOG_RATE_PER_MINUTE=120

# --- HTTP ---
HTTP_ADDR=:8080
EVENTS_FILE=data/events.jsonl
# Origin, на котором открывается Mini App (через запятую). "*" не рекомендуется.
# Для локальной отладки оставьте localhost; в production укажите свой домен.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_RECENT_EVENTS=1000
# Масштаб маркеров достопримечательностей на карте (1.0 — базовый).
MARKER_SCALE=3
SHUTDOWN_TIMEOUT=10s

# Лимиты и таймауты HTTP-сервера.
HTTP_MAX_BODY_BYTES=65536
HTTP_REQUEST_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s

# --- API событий ---
EVENTS_DEFAULT_LIMIT=50
EVENTS_MAX_LIMIT=500

# --- WebSocket-прокси браузер ↔ Yandex Realtime ---
WS_MAX_MESSAGE_BYTES=1048576
WS_PING_INTERVAL=20s
WS_PING_TIMEOUT=10s
WS_WRITE_TIMEOUT=10s

# --- Клиент Yandex Realtime ---
REALTIME_MAX_READ_BYTES=16777216
REALTIME_DIAL_TIMEOUT=15s
REALTIME_WRITE_TIMEOUT=10s

# --- Очистка сессий Гида ---
GUIDE_CLEANUP_INTERVAL=30s

# --- Валидация событий ---
EVENT_MAX_PLACE_ID_LEN=128
EVENT_MAX_NAME_LEN=300
EVENT_MAX_CATEGORY_LEN=64
EVENT_MAX_SESSION_ID_LEN=128
EVENT_MAX_USER_AGENT_LEN=512
EVENT_MAX_LANGUAGE_LEN=32
EVENT_MAX_PLATFORM_LEN=32
EVENT_MAX_REMOTE_IP_LEN=64
EVENT_MAX_CLOCK_SKEW=24h
EVENT_MAX_AGE=720h

# --- Telegram ---
# Токен бота. Обязателен для проверки initData.
# Скопируйте реальное значение в backend/.env, не в этот файл.
TELEGRAM_BOT_TOKEN=
# Максимальный возраст initData.
TELEGRAM_INIT_DATA_MAX_AGE=24h
# Только для локальной отладки в браузере: запросы без initData
# считаются пользователем с этим Telegram id. scripts/start_services.py
# выставляет 1 при первом локальном запуске. В production оставьте 0.
DEV_AUTH_USER_ID=0

# --- Yandex AI Studio Realtime ---
# API-ключ и folder id. Без них голосовой Гид вернёт 503.
# Скопируйте реальные значения в backend/.env, не в этот файл.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_REALTIME_URL=wss://ai.api.cloud.yandex.net/v1/realtime
# По умолчанию: gpt://<YANDEX_FOLDER_ID>/speech-realtime-deepseek-v4-flash
# Другие модели Realtime API:
#   gpt://<folder_id>/speech-realtime-max-tts-live/latest
#   gpt://<folder_id>/speech-realtime-tts-live/latest  (только синтез)
YANDEX_REALTIME_MODEL=
# 16 кГц — wideband-речь: разборчиво для STT и в 2,75 раза легче 44,1 кГц.
YANDEX_INPUT_RATE=16000
YANDEX_OUTPUT_RATE=16000
YANDEX_VOICE=alena
YANDEX_VOICE_ROLE=good
YANDEX_VAD_THRESHOLD=0.5
YANDEX_VAD_SILENCE_MS=400

# --- Сессия Гида ---
# Системный промпт голосового Гида.
# Кавычки обязательны: значения с пробелами должны быть в кавычках.
GUIDE_INSTRUCTIONS="Ты умный, общительный гид по историческим достопримечательностям. Ты рассказываешь только факты, шутишь. Пользователь тебя может перебить и что-то уточнить. Отвечай живо и кратко, голосом, без списков и markdown."
SESSION_TTL=2h
REALTIME_TOKEN_TTL=60s
